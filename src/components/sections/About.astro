---
// Statement on the left, a pile of polaroids on the right that fans out as you scroll
// (scripts/features/photo-pile.js). Without JS the polaroids simply sit in their spread positions.
import Photo from "../ui/Photo.astro";
import Icon from "../ui/Icon.astro";
import { about } from "../../data/content.js";
import { emphasize } from "../../lib/text.js";
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="about-grid">
    <div class="about-copy">
      <p class="kicker" data-reveal>{about.kicker}</p>
      <h2 class="about-statement" id="about-title" data-split data-marker set:html={emphasize(about.statement)} />
      <p class="about-body" data-reveal>{about.body}</p>
      <a class="btn btn--ghost" href={about.cta.href} data-reveal>
        {about.cta.label}
        <Icon name="arrow" class="btn-icon" />
      </a>
    </div>

    <div class="photo-pile" data-photo-pile>
      {
        about.photos.map((item, i) => (
          <figure class="polaroid" style={`--i:${i}`} data-polaroid>
            <div class="polaroid-card">
              <Photo src={item.photo} alt={item.alt} widths={[320, 480, 640]} sizes="(min-width: 760px) 20vw, 50vw" />
              <figcaption>{item.caption}</figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 7rem);
  }

  .about-statement {
    max-width: 21ch;
    font-size: clamp(2.1rem, 1.2rem + 2.7vw, 4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.05em;
  }

  /* Highlighter swipe behind the *emphasized* words (JS animates --mark from 0% to 100%). */
  .about-statement :global(em) {
    --mark: 100%;
    background: linear-gradient(var(--red), var(--red)) no-repeat 0 88% / var(--mark) 0.32em;
    color: inherit;
  }

  .about-body {
    max-width: 34ch;
    margin: 2rem 0 2.25rem;
    color: var(--ink-soft);
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  /* ---------- Polaroids ---------- */
  .photo-pile {
    position: relative;
    aspect-ratio: 1 / 1.08;
  }

  .polaroid {
    position: absolute;
    z-index: calc(10 - var(--i));
    width: 50%;
    transition: z-index 0s 0.3s;
  }

  .polaroid:hover {
    z-index: 20;
    transition-delay: 0s;
  }

  /* Resting (spread) positions */
  .polaroid:nth-child(1) {
    top: 4%;
    left: 6%;
    --tilt: -7deg;
  }

  .polaroid:nth-child(2) {
    top: 0;
    right: 2%;
    --tilt: 6deg;
  }

  .polaroid:nth-child(3) {
    bottom: 2%;
    left: 0;
    --tilt: 4deg;
  }

  .polaroid:nth-child(4) {
    right: 8%;
    bottom: 0;
    --tilt: -5deg;
  }

  .polaroid-card {
    position: relative;
    padding: 0.6rem 0.6rem 0;
    background: #fffdf9;
    box-shadow: var(--shadow);
    rotate: var(--tilt, 0deg);
    transition:
      rotate 0.6s var(--ease-spring),
      scale 0.6s var(--ease-spring);
  }

  .polaroid:hover .polaroid-card {
    rotate: 0deg;
    scale: 1.06;
  }

  /* A strip of tape */
  .polaroid-card::before {
    position: absolute;
    z-index: 1;
    top: -0.75rem;
    left: 50%;
    width: 4.5rem;
    height: 1.5rem;
    background: rgb(235 222 196 / 0.75);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
    content: "";
    translate: -50% 0;
    rotate: calc(var(--tilt, 0deg) * -1.5);
  }

  .polaroid-card :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .polaroid figcaption {
    padding: 0.7rem 0.25rem 0.9rem;
    color: var(--ink-soft);
    font: 500 clamp(0.8rem, 0.7rem + 0.4vw, 1rem) / 1.2 var(--font-display);
    text-align: center;
  }

  @media (width < 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .photo-pile {
      width: min(100%, 34rem);
      margin-inline: auto;
    }
  }
</style>
