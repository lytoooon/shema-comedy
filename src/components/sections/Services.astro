---
// Each service is a row that fills red on hover and opens WhatsApp with a ready-made message.
import SectionHead from "../ui/SectionHead.astro";
import Icon from "../ui/Icon.astro";
import { services } from "../../data/content.js";
import { whatsappLink } from "../../data/site.js";
import { pad } from "../../lib/text.js";
---

<section class="section services" id="services" aria-labelledby="services-title">
  <SectionHead kicker={services.kicker} title={services.title} id="services-title" />

  <ol class="service-list">
    {
      services.items.map((item, i) => (
        <li data-reveal>
          <a
            class="service"
            href={whatsappLink(`Hi Shema! I’m interested in ${item.title.toLowerCase()}.`)}
            target="_blank"
            rel="noopener"
          >
            <span class="service-index">{pad(i + 1)}</span>
            <h3 class="service-title">{item.title}</h3>
            <p class="service-text">{item.text}</p>
            <span class="service-arrow">
              <Icon name="arrow" />
            </span>
            <span class="sr-only">Ask about this on WhatsApp (opens in a new tab)</span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .service-list {
    border-bottom: 1.5px solid var(--ink);
  }

  .service {
    position: relative;
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 24rem) 3.5rem;
    align-items: center;
    gap: 1rem 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) 1rem;
    isolation: isolate;
    border-top: 1.5px solid var(--ink);
    text-decoration: none;
    transition: color 0.5s var(--ease-out);
  }

  /* Red fill that rises on hover */
  .service::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--red);
    content: "";
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.6s var(--ease-out);
  }

  .service:hover,
  .service:focus-visible {
    color: var(--paper);
  }

  .service:hover::before,
  .service:focus-visible::before {
    transform: none;
  }

  .service-index {
    color: var(--red-text);
    font: 700 var(--text-sm) / 1 var(--font-display);
    letter-spacing: 0.1em;
    transition: color 0.5s var(--ease-out);
  }

  .service-title {
    font-size: clamp(2rem, 1.2rem + 3.6vw, 4.75rem);
    letter-spacing: -0.05em;
    transition: transform 0.6s var(--ease-out);
  }

  .service-text {
    color: var(--muted);
    line-height: 1.45;
    transition: color 0.5s var(--ease-out);
  }

  .service-arrow {
    display: grid;
    width: 3.5rem;
    height: 3.5rem;
    place-items: center;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px currentColor;
    transition:
      transform 0.6s var(--ease-spring),
      background-color 0.4s;
  }

  .service-arrow :global(svg) {
    width: 1.4rem;
  }

  .service:hover :is(.service-index, .service-text),
  .service:focus-visible :is(.service-index, .service-text) {
    color: var(--paper);
  }

  .service:hover .service-title {
    transform: translateX(0.75rem);
  }

  .service:hover .service-arrow {
    background: var(--paper);
    color: var(--red);
    transform: rotate(45deg);
  }

  @media (width < 900px) {
    .service {
      grid-template-columns: 2.5rem minmax(0, 1fr) 3rem;
      padding-inline: 0.5rem;
    }

    .service-text {
      grid-column: 2 / 3;
    }

    .service-arrow {
      grid-row: 1;
      grid-column: 3;
      width: 3rem;
      height: 3rem;
    }
  }
</style>
