---
// One pinned gallery. `layout` is "stack" (slides overlap, top one slides away)
// or "strip" (slides sit in a row and the track moves sideways).
const { id, sectionClass, kicker, kickerMotion, title, titleMotion, note, noteMotion, label, stageLabel, layout, items } =
  Astro.props;

const slides = items.slice(0, 4);
const pad = (n) => String(n).padStart(2, "0");
---

<section class={`chapter ${sectionClass}`} id={id} aria-labelledby={`${id}-title`}>
  <div class="gallery-heading">
    <div>
      <p class="chapter-kicker" data-reveal="left" data-motion={kickerMotion}>{kicker}</p>
      <h2 class="chapter-title" id={`${id}-title`} data-reveal="up" data-motion={titleMotion}>{title}</h2>
    </div>
    <p class="microcopy" data-reveal="right" data-motion={noteMotion}>{note}</p>
  </div>
  <div class="gallery-stage" data-gallery-stage data-layout={layout} data-label={label} aria-label={stageLabel}>
    <div class="gallery-track">
      {
        slides.map((item, i) => (
          <figure class="media-slot" aria-label={item.caption} style={`z-index:${4 - i}`}>
            <img src={item.src} alt={item.caption} loading="lazy" />
            <figcaption class="media-caption">
              <span>{item.caption}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <span class="gallery-progress" aria-hidden="true">{label} · 01 / {pad(slides.length)}</span>
  </div>
</section>
