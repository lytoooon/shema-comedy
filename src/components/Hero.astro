---
import { heroPhoto } from "../data/media.js";
---

<section class="chapter hero" id="top" aria-labelledby="hero-title">
  <div class="hero-topline" data-reveal="up" data-motion="whip">
    <span>Lifestyle &amp; comedy creator</span>
    <span>I’m based in Lusaka, Zambia</span>
  </div>

 <h1 class="hero-title" id="hero-title" aria-label="Shema Comedy">
  <svg viewBox="0 0 400 210" aria-hidden="true" focusable="false">
    <defs>
      <path id="hero-curve-1" d="M -100 120 Q 200 60 500 120" />
      <path id="hero-curve-2" d="M -100 201 Q 200 141 500 201" />
    </defs>
    <text text-anchor="middle">
      <textPath href="#hero-curve-1" startOffset="49%">SHEMA</textPath>
    </text>
    <text text-anchor="middle">
      <textPath href="#hero-curve-2" startOffset="49%">COMEDY</textPath>
    </text>
  </svg>
</h1>
  <figure class="hero-portrait" data-reveal="up" data-motion="portrait">
    <div class="portrait-window">
      <img src={heroPhoto} alt="Portrait of me, Shema" fetchpriority="high" />
    </div>
    <span class="portrait-stamp" aria-hidden="true">Lusaka · Zambia · 21</span>
  </figure>
  <div class="hero-bio">
  <p class="hero-caption" data-reveal="right" data-motion="fold">
    I make everyday life funny. Here’s what happens next.
  </p>
  <a class="hero-contact-link" href="#contact">Let’s talk</a>
  </div>
</section>
