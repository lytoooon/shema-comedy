---
// The page, top to bottom. Reorder or remove sections freely; numbering updates itself.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Ticker from "../components/sections/Ticker.astro";
import Reach from "../components/sections/Reach.astro";
import About from "../components/sections/About.astro";
import Work from "../components/sections/Work.astro";
import Results from "../components/sections/Results.astro";
import Services from "../components/sections/Services.astro";
import Moments from "../components/sections/Moments.astro";
import Partners from "../components/sections/Partners.astro";
import Contact from "../components/sections/Contact.astro";
---

<Base>
  <canvas class="fluid-canvas" data-fluid aria-hidden="true"></canvas>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    <Ticker />
    <Reach />
    <About />
    <Work />
    <Results />
    <Services />
    <Moments />
    <Partners />
    <Contact />
  </main>
  <Footer />
</Base>
