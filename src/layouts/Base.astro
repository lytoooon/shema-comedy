---
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/museomoderno/latin-500.css";
import "@fontsource/museomoderno/latin-700.css";
import "@fontsource/museomoderno/latin-800.css";
import "lenis/dist/lenis.css";
import "../styles/global.css";
import displayFont from "@fontsource/museomoderno/files/museomoderno-latin-800-normal.woff2?url";
import { site } from "../data/site.js";

const base = import.meta.env.BASE_URL;
const pageUrl = new URL(base, Astro.site).href;
const shareImage = new URL(`${base}${site.shareImage}`, Astro.site).href;

// Tells search engines who this page is about (shows up in rich results).
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.brand,
  alternateName: site.name,
  description: site.description,
  url: pageUrl,
  image: shareImage,
  jobTitle: "Lifestyle & comedy content creator",
  homeLocation: { "@type": "Place", name: site.location },
  sameAs: site.socials.map((social) => social.url),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <link rel="canonical" href={pageUrl} />
    <meta name="theme-color" content="#f6f2ec" />

    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Lets CSS know JS is running, so animated elements can start hidden without a flash. -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
